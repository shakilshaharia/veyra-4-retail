# ---------------------------------------------------------------------------
# Veyra CMS API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL 8 (or MariaDB). `pnpm --filter @workspace/cms-api db:start` runs a
# local dev server on 3307 with this exact URL.
# allowPublicKeyRetrieval lets the driver sign in with MySQL 8's default
# password plugin over a plain localhost connection.
# Production (CloudPanel): mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME?allowPublicKeyRetrieval=true
# (URL-encode special characters in the password, e.g. @ as %40.)
DATABASE_URL="mysql://veyra:veyra-dev@127.0.0.1:3307/veyra_cms?allowPublicKeyRetrieval=true"

# HTTP
PORT=4000
HOST=127.0.0.1
# Public origin of the site, used in emails, sitemap and canonical URLs.
PUBLIC_SITE_URL="http://localhost:3000"
# Where the dashboard lives; defaults to PUBLIC_SITE_URL/admin.
ADMIN_URL="http://localhost:3001/admin"
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Long random string; used to salt IP hashes and sign preview links.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="change-me"

# Session cookies get the Secure flag automatically when PUBLIC_SITE_URL is
# https. Set "true"/"false" only to override that.
# COOKIE_SECURE=true
SESSION_DAYS=14

# Media storage: "local" (files on this server) or "s3" (S3, R2, Spaces...).
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=100
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=            # only for S3-compatible providers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=          # e.g. https://cdn.example.com

# Email (password resets, form notifications). You can set SMTP up from the
# admin (Settings -> Email) instead of here; admin settings take priority.
# Leave both empty in development: messages are written to ./dev-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Veyra <no-reply@veyra4retail.com>"

# Optional reCAPTCHA v3. Without it, forms still use a honeypot, a minimum
# fill time and rate limiting.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Production only: built site and admin to serve from this process.
# SITE_DIST="../veyra-site/dist/public"
# ADMIN_DIST="../cms-admin/dist"
